{
    "name": "roundly-consulting/two-factor-for-laravel",
    "description": "Native RFC 6238 TOTP two-factor authentication for Laravel — encrypted secrets, single-use recovery codes and replay protection with zero third-party crypto.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "two-factor",
        "2fa",
        "totp",
        "mfa",
        "otp",
        "authentication"
    ],
    "homepage": "https://github.com/roundly-consulting/two-factor-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/collections": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/encryption": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "roundly-consulting/crypto-for-laravel": "@dev",
        "roundly-consulting/enums-for-laravel": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../crypto-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/crypto-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../enums-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/enums-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../package-toolkit-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/package-toolkit-for-laravel",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\TwoFactor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\TwoFactor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\TwoFactor\\TwoFactorServiceProvider"
            ],
            "aliases": {
                "TwoFactor": "RoundlyConsulting\\TwoFactor\\Facades\\TwoFactor"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
